<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>TafInstalledDeliveryTests</AssemblyName>
    <StartupObject>ThousandAndFirst.WorkshopSteam.DeliveryTests</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="UploadPackage.cs" />
    <Compile Include="UploadPackage.Install.cs" />
    <Compile Include="SteamInstalledDelivery.cs" />
    <Compile Include="UploadPackageTests.cs" />
    <Compile Include="UploadPackageInstalledTests.cs" />
    <Compile Include="DeliveryTests.cs" />
    <Compile Include="UploadProtocol.cs" />
    <Compile Include="SteamUploadAuthority.cs" />
    <Compile Include="../ScenarioFileTrust.cs" Link="ScenarioFileTrust.cs" />
    <Reference Include="com.rlabrecque.steamworks.net">
      <HintPath>$(QudManaged)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireInstalledSteamworks" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(QudManaged)/com.rlabrecque.steamworks.net.dll')"
      Text="Set QudManaged to the licensed installed Qud Managed directory." />
  </Target>
</Project>
