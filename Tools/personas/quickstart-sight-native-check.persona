# Real Quickstart; do not reactivate the zone or grant harness light/omniscience.
# Observe the whole zone during native draws, then exact ordinary LOS restoration.
DESCRIPTION=Quickstart immediately draws its entire claimed zone while gameplay retains ordinary line of sight
REQUEST=founding-first-city
SCRIPT=quickstart-lifecycle marsh yes;quickstart-sight-start;yield-frames 3;quickstart-sight-check;stagedigest
VERBS=quickstart-sight-start,quickstart-sight-check
EXPECT=QUICKSTART-BOOT-COMPLETE:OK,quickstart-sight-start:OK~attached-at-founding=true,yield-frames:OK,quickstart-sight-check:OK~whole-zone-drawn=true,stagedigest:OK,COMPLETE
SET=growth,native-regression
TIMEOUT=600
