# First leg only: save a real native release Intent after two receipt writes. No reload claim.
# Synthetic work/home and elapsed checkpoint; not ordinary play or historical-save compatibility.
DESCRIPTION=save a native subsidence release cut for a separate fresh-profile reload
REQUEST=founding-first-city
START=8.22@40,12
SCRIPT=stagedigest;subsidence-rung-save-check;stagedigest
VERBS=subsidence-rung-save-check
