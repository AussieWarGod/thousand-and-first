# Real founding; synthetic wrong-table states and direct shared-guard calls with native callbacks.
# Retains profile and original/foreign objects. Not terminal completion or ordinary-save acceptance.
DESCRIPTION=founding reservations reject malformed typed state and native factory substitutions without adopting foreign objects
REQUEST=founding-first-city
START=8.22@40,12
SCRIPT=stagedigest;founding-heart-check;stagedigest
VERBS=founding-heart-check
EXPECT=stagedigest:OK~founded=false,founding-heart-check:OK~cases=7 passed=7 failed=0,stagedigest:OK~founded=true,COMPLETE
LOG_EXPECT=["MODWARN [Pets of Harvest Dawn] - Mod defining manual load order, please convert it to use the Dependencies field.","MODWARN [Pets of Harvest Dawn] - XmlDataHelper:: <...>/steamapps/common/Caves of Qud/CoQ_Data/StreamingAssets/DLC/PetsPack1/Freehold_Pet_Ercolano/PopulationTables.xml line 4 char 6"]
SET=growth,native-regression
