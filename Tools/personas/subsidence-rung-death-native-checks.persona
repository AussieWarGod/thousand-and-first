# Real founding, fifteen departures and two engine deaths beneath one Prepared roof.
# Synthetic work, home and elapsed checkpoint; no death or roof state is fabricated.
# Retains profile/effects. Not ordinary construction, lodging assignment or save/load acceptance.
DESCRIPTION=unrelated and selected engine deaths retain the exact Prepared roof and settle death accounting once
REQUEST=founding-first-city
START=8.22@40,12
SCRIPT=stagedigest;subsidence-rung-death-check;stagedigest
VERBS=subsidence-rung-death-check
EXPECT=stagedigest:OK~founded=false,subsidence-rung-death-check:OK~cases=6 passed=6 failed=0,stagedigest:OK~founded=true,COMPLETE
LOG_EXPECT=["MODWARN [Pets of Harvest Dawn] - Mod defining manual load order, please convert it to use the Dependencies field.","MODWARN [Pets of Harvest Dawn] - XmlDataHelper:: <...>/steamapps/common/Caves of Qud/CoQ_Data/StreamingAssets/DLC/PetsPack1/Freehold_Pet_Ercolano/PopulationTables.xml line 4 char 6"]
SET=growth,native-regression
