DESCRIPTION=present counterpart: same advance turns and observed clocks, no invented travel overhead
REQUEST=founding-first-city
START=8.22@40,12
SCRIPT=stagedigest;realize;advance 1200;beta-present;advance 1200;beta-return;advance 39;yield-frames 1;beta-check;status
VERBS=beta-present,beta-return,beta-check
EXPECT=stagedigest:OK,realize:OK,advance:OK,beta-present:OK,advance:OK,beta-return:OK,advance:OK,yield-frames:OK,beta-check:OK~taf-travel-checked,status:OK,COMPLETE
CHECK=travel-present
SET=beta,travel
