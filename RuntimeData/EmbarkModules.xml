<?xml version="1.0" encoding="utf-8"?>
<embarkmodules>
  <module Class="XRL.CharacterBuilds.Qud.QudGamemodeModule">
    <modes>
      <mode ID="Kingdom" Title="Kingdom">
        <icon Tile="Items/sw_book_1.bmp" Foreground="y" Detail="W"></icon>
        <description>
          Character permadeath; kingdom continuity. When you die, your realm mourns you and its own senior heir takes the charter. If no heir stands, the dynasty ends.
        </description>
        <stringgamestate Name="GameMode" Value="Kingdom"></stringgamestate>
        <boolgamestate Name="r_TAF_KingdomMode" Value="true"></boolgamestate>
        <!-- Qud's gamesystem handler records the attribute but does not consume an end node;
             this element must therefore be empty/self-closing or the loader warns. -->
        <gamesystem Class="ThousandAndFirst.KingdomSuccession" />
      </mode>
      <mode ID="KingdomQuickstart" Title="Kingdom Quickstart">
        <icon Tile="Items/sw_book_1.bmp" Foreground="g" Detail="Y"></icon>
        <description>
          Begin on reviewed wilderness ground with a normally founded kingdom heart and modest physical provisions. Recommended for learning or testing The Thousand and First; the camp stores are finite and do not produce replacements.
        </description>
        <stringgamestate Name="GameMode" Value="KingdomQuickstart"></stringgamestate>
        <boolgamestate Name="r_TAF_KingdomMode" Value="true"></boolgamestate>
        <gamesystem Class="ThousandAndFirst.KingdomSuccession" />
      </mode>
    </modes>
  </module>
