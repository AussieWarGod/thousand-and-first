<populations>
  <!--
    Who actually turns up. A settlement of identical figures reads as a barracks,
    so arrivals roll from this table rather than from one blueprint. Every entry
	    Most entries inherit r_KingdomSettler. A creature-bodied entry may instead inherit
	    its vanilla body and explicitly carry r_KingdomSettler, AllowIdleBehavior, SleepOnBed,
	    and a calm wandering Brain; this keeps culture, species, anatomy, stats, equipment,
	    mutations, and TextFragments honest. Other mods merge either shape here.
  -->
  <population Name="r_KingdomSettlers" Load="Merge" Style="pickone">
	    <object Blueprint="r_KingdomSettler" Number="1" Weight="25" />
    <object Blueprint="r_KingdomSettlerHand" Number="1" Weight="20" />
    <object Blueprint="r_KingdomSettlerDrifter" Number="1" Weight="14" />
