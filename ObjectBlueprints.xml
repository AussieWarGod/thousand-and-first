<?xml version="1.0" encoding="utf-8"?>
<objects>
  <object Name="r_KingdomSettler" Inherits="BaseFarmer">
    <part Name="Render" DisplayName="settler" ColorString="&amp;w" />
    <part Name="Description" Short="Road-worn and rumor-led, they carry everything they own: a bedroll, an empty skin, and the name of a place where thirst is shared." />
    <part Name="Brain" Wanders="true" Hostile="false" />
    <tag Name="r_KingdomSettler" />
    <tag Name="AllowIdleBehavior" />
    <tag Name="SleepOnBed" />
  </object>
  <!--
    Settler variants. These inherit everything - tag, brain, idle behaviour - and
    override appearance only, so the people who arrive look like a mixed road
    rather than a uniform. All the tiles are the game's own; a settler needs no
    art of its own when the world is already full of ordinary people.
    Rolled from the r_KingdomSettlers population table, which other mods merge into.
  -->
  <object Name="r_KingdomSettlerHand" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="Creatures/farmer_convert.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerDrifter" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_23.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerTinker" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_21.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerScribe" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_20.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerYoung" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="Creatures/sw_appledaughter.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomScaffold" Inherits="Furniture">
    <part Name="Render" DisplayName="scaffolding" RenderString="&#9617;" ColorString="&amp;w" />
    <part Name="Description" Short="Lashed poles and borrowed planks. Somebody's promise is being kept, plank by plank." />
    <part Name="r_KingdomScaffold" />
    <part Name="Physics" Solid="false" Takeable="false" />
    <stat Name="Hitpoints" Value="50" />
  </object>
  <object Name="r_KingdomCaskRack" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="cask rack" RenderString="&#8801;" ColorString="&amp;w" Tile="ThousandAndFirst/r_KingdomCaskRack.png" TileColor="&amp;y" DetailColor="W" />
    <part Name="Description" Short="Casks in a cradle of watervine rope. The whole settlement is counted here, dram by dram." />
    <part Name="LiquidVolume" MaxVolume="64" Volume="0" />
    <part Name="Physics" Takeable="false" Organic="true" />
    <stat Name="Hitpoints" Value="80" />
  </object>
  <object Name="r_KingdomGreatCistern" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="great cistern" RenderString="O" ColorString="&amp;B" Tile="ThousandAndFirst/r_KingdomGreatCistern.png" TileColor="&amp;b" DetailColor="C" />
    <part Name="Description" Short="A tin-lined belly sunk to its rim in the earth. When it is full, the whole town sleeps easier; when it rings hollow, everyone hears it." />
    <part Name="LiquidVolume" MaxVolume="256" Volume="0" />
    <part Name="Physics" Takeable="false" Weight="2000" />
    <stat Name="Hitpoints" Value="200" />
  </object>
  <object Name="r_KingdomBunk" Inherits="Bed">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="communal bunk" ColorString="&amp;w" />
    <part Name="Description" Short="Rope-sprung and blanket-soft by local standards. It smells of road dust and relief." />
    <part Name="Physics" Takeable="false" />
  </object>
  <object Name="r_KingdomBench" Inherits="BaseChair">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="gathering bench" RenderString="&#960;" ColorString="&amp;w" />
    <part Name="Description" Short="Split logs worn smooth by sitting. The best arguments of the settlement happen here, and one or two of the marriages." />
    <part Name="Physics" Takeable="false" />
    <stat Name="Hitpoints" Value="80" />
  </object>
  <object Name="r_KingdomShrine" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="shrine stone" RenderString="&#933;" ColorString="&amp;Y" />
    <part Name="Description" Short="An uncut stone with a cup-shaped hollow worn into its crown. Whatever is poured there is gone by morning, and no one asks where." />
    <part Name="Shrine" />
    <part Name="Physics" Takeable="false" Weight="1000" />
    <stat Name="Hitpoints" Value="150" />
  </object>
  <object Name="r_KingdomChargingPost" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="charging post" RenderString="&#227;" ColorString="&amp;C" />
    <part Name="Description" Short="A salvaged cradle of chrome and gut-wire, cranked by whoever has the shift. Set your cells on it and go eat; they will be full when you come back." />
    <part Name="UniversalCharger" ChargeRate="150" />
    <part Name="r_KingdomHandCrank" />
    <part Name="Container" Preposition="on" />
    <part Name="Inventory" />
    <part Name="Physics" Takeable="false" Weight="800" />
    <property Name="DontWarnOnOpen" Value="true" />
    <stat Name="Hitpoints" Value="150" />
  </object>
  <object Name="r_KingdomPalisade" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="thorn palisade" RenderString="#" ColorString="&amp;y" Tile="ThousandAndFirst/r_KingdomPalisade.png" TileColor="&amp;y" DetailColor="w" Occluding="true" />
    <part Name="Description" Short="Cut thornbrush lashed between stakes, taller than a man and meaner. It will not stop anyone determined. It will slow them down where your people can see them." />
    <part Name="Physics" Solid="true" Takeable="false" Weight="900" />
    <stat Name="Hitpoints" Value="120" />
    <stat Name="AV" Value="4" />
  </object>
  <object Name="r_KingdomWatchtower" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="watchtower" RenderString="&#8593;" ColorString="&amp;W" Tile="ThousandAndFirst/r_KingdomWatchtower.png" TileColor="&amp;y" DetailColor="W" />
    <part Name="Description" Short="A platform on four legs with a bell and a good view of the road. The watch complains about the wind and never once about the posting." />
    <part Name="Physics" Takeable="false" Weight="2000" />
    <stat Name="Hitpoints" Value="220" />
  </object>
  <object Name="r_KingdomRampart" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="stone rampart" RenderString="&#9619;" ColorString="&amp;w" Occluding="true" Tile="ThousandAndFirst/r_KingdomRampart.png" TileColor="&amp;w" DetailColor="W" />
    <part Name="Description" Short="Fieldstone laid without mortar, wide enough at the base to stand on. It took a season and everyone's back, and it will outlast everyone who built it." />
    <part Name="Physics" Solid="true" Takeable="false" Weight="4000" />
    <stat Name="Hitpoints" Value="400" />
    <stat Name="AV" Value="10" />
  </object>
  <object Name="r_FoundingBook" Inherits="Book">
    <part Name="Render" DisplayName="{{W|On the Founding of Places}}" />
    <part Name="Description" Short="A thin codex in a plain wrapper, copied and recopied by people who had reason to. The margins argue with the text." />
    <part Name="Book" ID="r_OnTheFoundingOfPlaces" />
    <part Name="Commerce" Value="45" />
  </object>
  <object Name="r_FounderBasin" Inherits="WaterContainer">
    <part Name="LiquidVolume" MaxVolume="16" Volume="0" />
    <part Name="Render" DisplayName="founder's basin" RenderString="}" ColorString="&amp;B" Tile="Items/sw_catchbasin.bmp" TileColor="&amp;B" DetailColor="C" />
    <part Name="Description" Short="Hammered from tin and older promises, it holds just enough water to make strangers into kin. Whoever fills it and pours may found a place worth thirsting for." />
    <part Name="r_FounderBasin" />
    <part Name="Commerce" Value="25" />
  </object>
</objects>
