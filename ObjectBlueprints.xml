<?xml version="1.0" encoding="utf-8"?>
<objects>
  <object Name="r_KingdomSettler" Inherits="BaseFarmer">
    <part Name="Render" DisplayName="settler" ColorString="&amp;w" />
    <part Name="Description" Short="Road-worn and rumor-led, they carry everything they own: a bedroll, an empty skin, and the name of a place where thirst is shared." />
    <part Name="Brain" Wanders="true" Hostile="false" />
    <tag Name="r_KingdomSettler" />
    <tag Name="AllowIdleBehavior" />
    <tag Name="SleepOnBed" />
  </object>
  <!--
    Settler variants. These inherit everything - tag, brain, idle behaviour - and
    override appearance only, so the people who arrive look like a mixed road
    rather than a uniform. All the tiles are the game's own; a settler needs no
    art of its own when the world is already full of ordinary people.
    Rolled from the r_KingdomSettlers population table, which other mods merge into.
  -->
  <object Name="r_KingdomSettlerHand" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="Creatures/farmer_convert.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerDrifter" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_23.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerTinker" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_21.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerScribe" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="creatures/caste_20.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomSettlerYoung" Inherits="r_KingdomSettler">
    <part Name="Render" DisplayName="settler" Tile="Creatures/sw_appledaughter.bmp" ColorString="&amp;w" />
  </object>
  <!--
    Guests: travellers who are not settling. They roll from r_KingdomGuests (mergeable by other
    mods, same shape as r_KingdomSettlers), carry no SleepOnBed tag and are never enrolled, so
    they are never counted as population and never claim a bed. r_KingdomGuest (the part) is
    ThousandAndFirst's KingdomLocus.OfferGuestWater entry point.
  -->
  <object Name="r_KingdomGuest" Inherits="BaseFarmer">
    <part Name="Render" DisplayName="traveller" ColorString="&amp;w" />
    <part Name="Description" Short="Dust of a dozen roads on their boots, and no bedroll unpacked. They are only stopping." />
    <part Name="Brain" Wanders="true" Hostile="false" />
    <part Name="r_KingdomGuest" />
    <tag Name="r_KingdomGuest" />
    <tag Name="AllowIdleBehavior" />
  </object>
  <object Name="r_KingdomGuestPilgrim" Inherits="r_KingdomGuest">
    <part Name="Render" DisplayName="traveller" Tile="creatures/caste-pilgrim.png" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomGuestNomad" Inherits="r_KingdomGuest">
    <part Name="Render" DisplayName="traveller" Tile="creatures/caste_19.bmp" ColorString="&amp;w" />
  </object>
  <object Name="r_KingdomScaffold" Inherits="Furniture">
    <!-- No DetailColor: the scaffold grid is drawn in body pixels only, deliberately, so there is
         nothing for a highlight colour to tint. Adding one would imply a second tone that is not there. -->
    <part Name="Render" DisplayName="scaffolding" RenderString="&#9617;" ColorString="&amp;w" Tile="ThousandAndFirst/r_KingdomScaffold.png" TileColor="&amp;y" />
    <part Name="Description" Short="Lashed poles and borrowed planks. Somebody's promise is being kept, plank by plank." />
    <part Name="r_KingdomScaffold" />
    <part Name="Physics" Solid="false" Takeable="false" />
    <stat Name="Hitpoints" Value="50" />
  </object>
  <object Name="r_KingdomCaskRack" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="cask rack" RenderString="&#8801;" ColorString="&amp;w" Tile="ThousandAndFirst/r_KingdomCaskRack.png" TileColor="&amp;y" DetailColor="W" />
    <part Name="Description" Short="Casks in a cradle of watervine rope. The whole settlement is counted here, dram by dram." />
    <part Name="LiquidVolume" MaxVolume="64" Volume="0" />
    <part Name="Physics" Takeable="false" Organic="true" />
    <stat Name="Hitpoints" Value="80" />
  </object>
  <object Name="r_KingdomGreatCistern" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="great cistern" RenderString="O" ColorString="&amp;B" Tile="ThousandAndFirst/r_KingdomGreatCistern.png" TileColor="&amp;b" DetailColor="C" />
    <part Name="Description" Short="A tin-lined belly sunk to its rim in the earth. When it is full, the whole town sleeps easier; when it rings hollow, everyone hears it." />
    <part Name="LiquidVolume" MaxVolume="256" Volume="0" />
    <part Name="Physics" Takeable="false" Weight="2000" />
    <stat Name="Hitpoints" Value="200" />
  </object>
  <!-- Inherits the vanilla Chest wholesale (Container, Inventory, and its tile) rather than
       declaring a Tile of our own: STANDARDS.md requires art for anything that carries one, and
       reusing an existing, already-wired vanilla tile is the surest way to owe none. -->
  <object Name="r_KingdomLarder" Inherits="Chest">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="civic larder" />
    <part Name="Description" Short="A communal chest with a slatted lid, cool air moving through the gaps. What is put in here feeds the settlement, not just whoever finds it first." />
    <part Name="Physics" Takeable="false" Organic="true" />
    <stat Name="Hitpoints" Value="80" />
  </object>
  <!-- Declares no Tile of our own: the r_KingdomPlot part (Growth/KingdomPlot.cs) reuses the
       exact tile string vanilla's own Watervine object renders with (ZoneTerrain.xml), and
       recolors it in code the same way Watervine's own Harvestable declaration recolors ripe
       and unripe, rather than shipping new art for a plot whose crop already varies by style. -->
  <object Name="r_KingdomPlot" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="tended plot" RenderString="244" ColorString="&amp;K" Tile="Assets_Content_Textures_Tiles_sw_watervine1.bmp" TileColor="&amp;w" DetailColor="K" />
    <part Name="Description" Short="A patch of turned earth, staked and weeded by hands that have somewhere else to be. What comes up depends on what the ground already knew how to grow, long before anyone asked it to." />
    <part Name="r_KingdomPlot" />
    <part Name="Physics" Takeable="false" Organic="true" Weight="200" />
    <stat Name="Hitpoints" Value="60" />
  </object>
  <object Name="r_KingdomBunk" Inherits="Bed">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="communal bunk" ColorString="&amp;w" />
    <part Name="Description" Short="Rope-sprung and blanket-soft by local standards. It smells of road dust and relief." />
    <part Name="Physics" Takeable="false" />
  </object>
  <object Name="r_KingdomBench" Inherits="BaseChair">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="gathering bench" RenderString="&#960;" ColorString="&amp;w" />
    <part Name="Description" Short="Split logs worn smooth by sitting. The best arguments of the settlement happen here, and one or two of the marriages." />
    <part Name="Physics" Takeable="false" />
    <stat Name="Hitpoints" Value="80" />
  </object>
  <object Name="r_KingdomShrine" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="shrine stone" RenderString="&#933;" ColorString="&amp;Y" Tile="ThousandAndFirst/r_KingdomShrine.png" TileColor="&amp;y" DetailColor="Y" />
    <part Name="Description" Short="An uncut stone with a cup-shaped hollow worn into its crown. Whatever is poured there is gone by morning, and no one asks where." />
    <part Name="Shrine" />
    <part Name="Physics" Takeable="false" Weight="1000" />
    <stat Name="Hitpoints" Value="150" />
  </object>
  <object Name="r_KingdomCairn" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="settler's cairn" RenderString="&#8224;" ColorString="&amp;w" DetailColor="w" />
    <part Name="Description" Short="A cairn of fieldstone, raised for someone the settlement has not yet lost. It waits." />
    <part Name="Physics" Takeable="false" Weight="1400" />
    <stat Name="Hitpoints" Value="150" />
  </object>
  <object Name="r_KingdomChargingPost" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="charging post" RenderString="&#227;" ColorString="&amp;C" Tile="ThousandAndFirst/r_KingdomChargingPost.png" TileColor="&amp;c" DetailColor="C" />
    <part Name="Description" Short="A salvaged cradle of chrome and gut-wire, cranked by whoever has the shift. Set your cells on it and go eat; they will be full when you come back." />
    <part Name="UniversalCharger" ChargeRate="150" />
    <!-- The crew fills this cradle (KingdomGrowth staffs it), so Charge routinely sits
         above the engine's 1000 default MinimumChargeToExplode. Vanilla Capacitor then
         detonates for its whole Charge on BeforeDeathRemovalEvent, which a raid can
         trigger - destroying settlers and player-placed objects the mod is not allowed
         to touch. Cranked civic furniture does not blow up: hold the charge, never arm it.
         ChargeRate stays 0 because the settlement fills it, not the grid. -->
    <part Name="Capacitor" MaxCharge="4000" ChargeRate="0" MinimumChargeToExplode="0" />
    <!-- Container and Inventory are a pair. Vanilla's own "Universal Charging Station" carries
         both, and Container.cs:129-141 dereferences ParentObject.Inventory after offering to
         store something - so a Container with no Inventory throws on the exact action this
         post's description invites. Inventory is also what UniversalCharger charges: its
         constructor sets WorksOnInventory, so without this the cradle could never have filled
         a cell. Furniture, which this inherits, carries no Inventory anywhere in its chain. -->
    <part Name="Container" Preposition="on" />
    <part Name="Inventory" />
    <part Name="Physics" Takeable="false" Weight="800" />
    <property Name="DontWarnOnOpen" Value="true" />
    <stat Name="Hitpoints" Value="150" />
  </object>
  <object Name="r_KingdomPalisade" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="thorn palisade" RenderString="#" ColorString="&amp;y" Tile="ThousandAndFirst/r_KingdomPalisade.png" TileColor="&amp;y" DetailColor="w" Occluding="true" />
    <part Name="Description" Short="Cut thornbrush lashed between stakes, taller than a man and meaner. It will not stop anyone determined. It will slow them down where your people can see them." />
    <part Name="Physics" Solid="true" Takeable="false" Weight="900" />
    <stat Name="Hitpoints" Value="120" />
    <stat Name="AV" Value="4" />
  </object>
  <object Name="r_KingdomWatchtower" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="watchtower" RenderString="&#8593;" ColorString="&amp;W" Tile="ThousandAndFirst/r_KingdomWatchtower.png" TileColor="&amp;y" DetailColor="W" />
    <part Name="Description" Short="A platform on four legs with a bell and a good view of the road. The watch complains about the wind and never once about the posting." />
    <part Name="Physics" Takeable="false" Weight="2000" />
    <stat Name="Hitpoints" Value="220" />
  </object>
  <object Name="r_KingdomRampart" Inherits="Furniture">
    <stag Name="Contemporary" />
    <part Name="Render" DisplayName="stone rampart" RenderString="&#9619;" ColorString="&amp;w" Occluding="true" Tile="ThousandAndFirst/r_KingdomRampart.png" TileColor="&amp;w" DetailColor="W" />
    <part Name="Description" Short="Fieldstone laid without mortar, wide enough at the base to stand on. It took a season and everyone's back, and it will outlast everyone who built it." />
    <part Name="Physics" Solid="true" Takeable="false" Weight="4000" />
    <stat Name="Hitpoints" Value="400" />
    <stat Name="AV" Value="10" />
  </object>
  <object Name="r_FoundingBook" Inherits="Book">
    <part Name="Render" DisplayName="{{W|On the Founding of Places}}" Tile="ThousandAndFirst/r_FoundingBook.png" TileColor="&amp;y" DetailColor="W" />
    <part Name="Description" Short="A thin codex in a plain wrapper, copied and recopied by people who had reason to. The margins argue with the text." />
    <part Name="Book" ID="r_OnTheFoundingOfPlaces" />
    <part Name="Commerce" Value="45" />
  </object>
  <object Name="r_FounderBasin" Inherits="WaterContainer">
    <part Name="LiquidVolume" MaxVolume="16" Volume="0" />
    <part Name="Render" DisplayName="founder's basin" RenderString="}" ColorString="&amp;B" Tile="Items/sw_catchbasin.bmp" TileColor="&amp;B" DetailColor="C" />
    <part Name="Description" Short="Hammered from tin and older promises, it holds just enough water to make strangers into kin. Whoever fills it and pours may found a place worth thirsting for." />
    <part Name="r_FounderBasin" />
    <part Name="Commerce" Value="25" />
  </object>
  <!--
    Power. Three works and a store. Every one of them is somebody's shift first and a machine
    second, which is why none of them is wired to anything: KingdomPower reads their rating and
    their crew and carries the charge across. The vanilla turbine parts are here for their own
    sake - they drive the animated tiles, and a founder who ever does lay gearbox fence gets
    vanilla's mechanical grid on top, for free. Tiles are vanilla's own, so none of this owes art.
  -->
  <object Name="r_KingdomMill" Inherits="Furniture">
    <part Name="Render" DisplayName="crank mill" RenderString="15" ColorString="&amp;y" Tile="Items/sw_millstone_1.bmp" TileColor="&amp;y" DetailColor="w" />
    <part Name="Description" Short="A millstone yoked to a walking-bar. Three settlers lean into it from first light and spell each other at noon, and the shaft they turn runs under the packed floor to wherever the settlement wants the charge." />
    <part Name="r_KingdomPowerWork" Source="Hands" />
    <!-- No MechanicalPowerTransmission: a producer with nothing behind it to produce from would
         advertise a vanilla grid connection it could never honour. Hands power is civic only. -->
    <part Name="Physics" Takeable="false" Weight="900" />
    <stat Name="Hitpoints" Value="250" />
    <stag Name="Contemporary" />
  </object>
  <object Name="r_KingdomWaterWheel" Inherits="Furniture">
    <part Name="Render" DisplayName="settlement water wheel" RenderString="21" ColorString="&amp;w" Tile="Items/sw_waterwheel_1.bmp" TileColor="&amp;w" DetailColor="y" />
    <part Name="Description" Short="Paddles the settlement cut and lashed itself, set where the water already runs. Somebody greases the shaft each morning and pulls the weed off the buckets. That is the whole of the work, and it is somebody's." />
    <part Name="r_KingdomPowerWork" Source="Water" />
    <!-- Vanilla's own numbers, matched on purpose: KingdomPowerRules.HydraulicMinimumDrams and
         HydraulicRatedDrams are these two figures, so the wheel's operational state and the
         settlement's report never disagree in front of the player. -->
    <part Name="HydroTurbine" MinimumEffectiveVolume="400" MaximumEffectiveVolume="4000" MaximumChargeRate="10" IsTechScannable="false" />
    <part Name="MechanicalPowerTransmission" ChargeRate="100" IsProducer="true" IsTechScannable="false" />
    <part Name="Circuitry" MaxCharge="100" IsEMPSensitive="false" IsTechScannable="false" NameForStatus="Gearbox" />
    <part Name="AnimatedMaterialGeneric" AnimationLength="300" TileAnimationFrames="0=default,100=Items/sw_waterwheel_2.bmp,200=Items/sw_waterwheel_3.bmp" RequiresOperationalActivePart="HydroTurbine" />
    <part Name="Physics" Takeable="false" Weight="600" Organic="true" />
    <stat Name="Hitpoints" Value="400" />
    <stat Name="ColdResistance" Value="75" />
    <stag Name="Contemporary" />
  </object>
  <object Name="r_KingdomSailvane" Inherits="Furniture">
    <part Name="Render" DisplayName="sailvane" RenderString="21" ColorString="&amp;w" Tile="Items/sw_windmill_1.bmp" TileColor="&amp;w" DetailColor="y" />
    <part Name="Description" Short="Four arms of brined wood and patched sailcloth on a post, trimmed by whoever draws the shift. On a still day it stands there being a landmark, and the settlement finds other work for the hands." />
    <part Name="r_KingdomPowerWork" Source="Wind" />
    <part Name="WindTurbine" ChargeRateFactor="0.2" IsTechScannable="false" />
    <part Name="MechanicalPowerTransmission" ChargeRate="100" IsProducer="true" IsTechScannable="false" />
    <part Name="Circuitry" MaxCharge="100" IsEMPSensitive="false" IsTechScannable="false" NameForStatus="Gearbox" />
    <part Name="AnimatedMaterialGeneric" AnimationLength="300" TileAnimationFrames="0=default,100=Items/sw_windmill_2.bmp,200=Items/sw_windmill_3.bmp" RequiresOperationalActivePart="WindTurbine" />
    <part Name="Physics" Takeable="false" Weight="1000" Organic="true" />
    <stat Name="Hitpoints" Value="250" />
    <stat Name="ColdResistance" Value="75" />
    <stag Name="Contemporary" />
  </object>
  <object Name="r_KingdomSaltStore" Inherits="Furniture">
    <part Name="Render" DisplayName="molten-salt store" RenderString="234" ColorString="&amp;W" Tile="Items/sw_kiln.bmp" TileColor="&amp;W" DetailColor="R" />
    <part Name="Description" Short="A jacketed pit of salt kept molten by the day's work and tapped after dark. The salt was already here. It is the one thing this country has never been short of." />
    <part Name="r_KingdomPowerStore" />
    <!-- MinimumChargeToExplode="0" for exactly the reason the charging post carries it: a
         Capacitor the settlement deliberately keeps full detonates for its whole Charge on
         BeforeDeathRemovalEvent, which a raid can trigger, destroying settlers and player-placed
         objects this mod is not allowed to touch. ChargeRate="0" because nothing fills this but
         the settlement's own crew, through KingdomPower, which measures the capacitor before and
         after rather than trusting an engine call. -->
    <part Name="Capacitor" MaxCharge="24000" ChargeRate="0" MinimumChargeToExplode="0" Description="salt bed" />
    <part Name="Physics" Takeable="false" Weight="4000" />
    <property Name="DontWarnOnOpen" Value="true" />
    <stat Name="Hitpoints" Value="200" />
    <stat Name="AV" Value="6" />
    <stag Name="Contemporary" />
  </object>
</objects>
