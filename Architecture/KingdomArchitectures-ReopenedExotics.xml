    <glyph Char="#" Ground="$floor" Structure="$wall" Claim="yard" Pass="blocked" Cover="open" />
    <glyph Char="i" Ground="$floor" Claim="yard" Pass="walk" Cover="open" />
    <glyph Char="r" Ground="$path" Claim="yard" Pass="walk" Cover="open" Anchors="ward:boundary" />
    <glyph Char="+" Ground="$ground" Claim="yard" Pass="walk" Cover="open" Anchors="entrance:public" />
    <glyph Char="=" Ground="$ground" Claim="yard" Pass="walk" Cover="open" Anchors="entrance:service" />
    <glyph Char="D" Ground="$floor" Structure="$door" Claim="yard" Pass="walk" Cover="open" />
    <glyph Char="E" Ground="$floor" Structure="$door" Claim="yard" Pass="walk" Cover="open" />
    <glyph Char="S" Ground="$floor" Object="$seat" Claim="yard" Pass="adjacent" Cover="open" Anchors="rite:assent-seat" Stateful="yes" />
    <glyph Char="c" Ground="$floor" Object="$chime" Claim="yard" Pass="adjacent" Cover="open" Anchors="rite:chime" Stateful="yes" />
    <glyph Char="R" Ground="$path" Object="$chime" Claim="yard" Pass="adjacent" Cover="open" Anchors="ward:buttress" Stateful="yes" />
    <glyph Char="F" Ground="$path" Object="$focus" Claim="yard" Pass="adjacent" Cover="open" Anchors="ward:focus" Stateful="yes" />
    <glyph Char="C" Ground="$path" Object="$conductor" Claim="yard" Pass="adjacent" Cover="open" Anchors="rite:conductor" Stateful="yes" />
    <glyph Char="X" Ground="$path" Object="$register" Claim="yard" Pass="adjacent" Cover="open" Anchors="ward:exemption" Stateful="yes" />
    <glyph Char="@" Ground="$path" Object="$building" Claim="yard" Pass="adjacent" Cover="open" Anchors="main,function:assenting-moot" Stateful="yes" />
    <glyph Char="L" Ground="$floor" Object="$light" Claim="yard" Pass="walk" Cover="open" Anchors="light:rite" Stateful="yes" />
    <row Cells="...................." />
