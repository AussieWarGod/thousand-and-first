  <palette Key="reopened-stasis-arclight">
    <slot Key="ground" Blueprint="SaltPath" Role="retained-saltstone-vault-approach" Material="stone" MinTech="hands" Natural="yes" />
    <slot Key="floor" Blueprint="SmallHexFloor" Role="clean-service-floor" Material="shapedstone" MinTech="workshop" Natural="no" />
    <slot Key="wall" Blueprint="r_KingdomStructureConcreteWall" Role="cast-vault-shell" Material="shapedstone" MinTech="foundry" Natural="no" />
    <slot Key="partition" Blueprint="r_KingdomStructureRustedMetalWall" Role="recovered-bay-partition" Material="scrap" MinTech="salvage" Natural="no" />
    <slot Key="door" Blueprint="r_KingdomFixtureDoorSecurity" Role="interlocked-vault-door" Material="workedmetal" MinTech="arclight" Natural="no" />
    <slot Key="bay" Blueprint="r_KingdomStasisCradle" Role="inert-body-bay" Material="workedmetal" MinTech="arclight" Natural="no" />
    <slot Key="projector" Blueprint="r_KingdomStasisProjectorFixture" Role="disconnected-stasis-projector" Material="workedmetal" MinTech="arclight" Natural="no" />
    <slot Key="operator" Blueprint="r_KingdomFixtureTableMarble" Role="custody-console" Material="marble" MinTech="workshop" Natural="no" />
    <slot Key="transfer" Blueprint="r_KingdomFixtureTableStone" Role="body-transfer-slab" Material="shapedstone" MinTech="workshop" Natural="no" />
    <slot Key="locker" Blueprint="r_KingdomFixtureLockerScrap" Role="empty-effects-locker" Material="scrap" MinTech="salvage" Natural="no" />
    <slot Key="light" Blueprint="Techlight1" Role="custody-light" Material="workedmetal" MinTech="foundry" Natural="no" />
  </palette>

  <!--
    Four physically separate bays share one clean transfer room, operator station, effects
    locker, and disconnected projector. Two interlocked transfer vestibules preserve a clean
    custody path. The plan never doubles as a grafting/cybernetics theatre: the transfer tables
    are custody ground, and all body work must happen after a live body exits.
  -->
  <map Key="reopened-stasisvault-xl0" Width="20" Height="18" Footprint="0,0,20x18" DefaultCover="walled">
    <glyph Char="#" Ground="$floor" Structure="$wall" Claim="building" Pass="blocked" Cover="walled" />
    <glyph Char="p" Ground="$floor" Structure="$partition" Claim="building" Pass="blocked" Cover="walled" />
    <glyph Char="i" Ground="$floor" Claim="building" Pass="walk" Cover="walled" />
    <glyph Char="+" Ground="$ground" Claim="yard" Pass="walk" Cover="open" Anchors="entrance:public" />
    <glyph Char="D" Ground="$floor" Structure="$door" Claim="building" Pass="walk" Cover="walled" />
    <glyph Char="E" Ground="$floor" Structure="$door" Claim="building" Pass="walk" Cover="walled" Anchors="entrance:service,service:loading" />
    <glyph Char="B" Ground="$floor" Object="$bay" Claim="building" Pass="adjacent" Cover="walled" Anchors="stasis:body-bay" Stateful="yes" />
    <glyph Char="P" Ground="$floor" Object="$projector" Claim="building" Pass="adjacent" Cover="walled" Anchors="stasis:power" Stateful="yes" />
