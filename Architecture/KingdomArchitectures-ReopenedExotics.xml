  <plan Key="reopened-assenting-moot">
    <binding Key="knowledge-xl-assentingmoot" Type="knowledge" Size="XL" Facing="road">
      <tier Key="assentingmoot" BuildKey="assentingmoot" Level="0" Map="reopened-assentingmoot-xl0" Palette="reopened-assent-arclight">
        <require Role="main" Min="1" Max="1" />
        <require Role="entrance:public" Min="2" />
        <require Role="entrance:service" Min="2" />
        <require Role="function:assenting-moot" Min="1" Max="1" />
        <require Role="rite:assent-seat" Min="6" Max="6" />
        <require Role="rite:conductor" Min="1" Max="1" />
        <require Role="ward:focus" Min="1" Max="1" />
        <require Role="ward:exemption" Min="1" Max="1" />
        <require Role="ward:boundary" Min="18" Max="18" />
        <require Role="light:rite" Min="3" />
        <variant Key="fallback" Priority="0" />
      </tier>
    </binding>
  </plan>

  <plan Key="reopened-stasis-vault">
    <binding Key="craft-xl-stasisvault" Type="craft" Size="XL" Facing="road">
      <tier Key="stasisvault" BuildKey="stasisvault" Level="0" Map="reopened-stasisvault-xl0" Palette="reopened-stasis-arclight">
        <require Role="main" Min="1" Max="1" />
        <require Role="entrance:public" Min="2" />
        <require Role="entrance:service" Min="1" Max="1" />
        <require Role="function:stasis-vault" Min="1" Max="1" />
        <require Role="stasis:body-bay" Min="4" Max="4" />
        <require Role="stasis:power" Min="1" Max="1" />
        <require Role="stasis:operator" Min="1" Max="1" />
        <require Role="stasis:transfer" Min="1" Max="1" />
        <require Role="storage:effects" Min="1" Max="1" />
        <require Role="light:custody" Min="3" />
        <variant Key="fallback" Priority="0" />
      </tier>
    </binding>
  </plan>

</KingdomArchitectures>
