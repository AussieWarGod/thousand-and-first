<?xml version="1.0" encoding="utf-8"?>
<!--
  Reopened exotic floors whose gameplay authorities are still ACTIVE work.

  These plans are complete physical contracts but their catalogue records are sealed behind
  city-held activation keys that no shipped research node grants. Runtime owners may expose them
  only after they can honour the exact anchors below; until then no inert commission is offered.

  Every machine-looking fixture is a render-only local wrapper. In particular, no raw NormCore,
  StasisProjector, Stasisfield, regeneration tank, populated container, reactor, power receiver,
  deployment maintainer, or reality-stabilization field is stamped by these maps.
-->
<KingdomArchitectures Schema="1">

  <palette Key="reopened-assent-arclight">
	<slot Key="ground" Blueprint="DirtFloor" Role="far-moonstair-approach" Material="mud" MinTech="hands" Natural="yes" />
    <slot Key="floor" Blueprint="MarbleFloor" Role="open-rite-floor" Material="marble" MinTech="workshop" Natural="no" />
    <slot Key="path" Blueprint="SmallHexFloor" Role="assent-circuit" Material="shapedstone" MinTech="workshop" Natural="no" />
    <slot Key="wall" Blueprint="r_KingdomStructureHalfStone" Role="open-moot-boundary" Material="stone" MinTech="hands" Natural="no" />
    <slot Key="door" Blueprint="r_KingdomFixtureDoorMetal" Role="ward-threshold" Material="workedmetal" MinTech="foundry" Natural="no" />
    <slot Key="seat" Blueprint="r_KingdomFixtureChairMarble" Role="assenting-seat" Material="marble" MinTech="workshop" Natural="no" />
    <slot Key="chime" Blueprint="r_KingdomAssentChime" Role="faceted-marble-chime" Material="marble" MinTech="arclight" Natural="no" />
    <slot Key="focus" Blueprint="r_KingdomAssentFocus" Role="inert-consent-focus" Material="workedmetal" MinTech="arclight" Natural="no" />
    <slot Key="conductor" Blueprint="r_KingdomFixtureTableMarble" Role="rite-conductor-table" Material="marble" MinTech="workshop" Natural="no" />
    <slot Key="register" Blueprint="r_KingdomFixtureShelfMetal" Role="exemption-register" Material="workedmetal" MinTech="foundry" Natural="no" />
    <slot Key="light" Blueprint="Techlight1" Role="rite-light" Material="workedmetal" MinTech="foundry" Natural="no" />
  </palette>

  <!--
    The moot is a congregation, not a norm-core room: six witness seats surround a walkable
    eighteen-cell assent circuit. Faceted marble chimes bracket the one inert focus. The public
    procession enters two abreast through a light-and-chime forecourt; a separate service
    threshold reaches the register directly.
  -->
