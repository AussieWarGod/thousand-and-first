<!--
  Directional early-housing conversions. The declaration authorizes a priced change on the exact
  typed plot; the authored before/after maps decide whether that change renovates static fabric,
  expands additively inside the reservation, or combines both. Protected live state must remain
  exact or use an explicit handover. M/L/XL records are distinct because actual staked size is part
  of route identity and each size must be a real design, never generic padding around an S core.

  These are deliberately one-way. Taking a sound hut back to canvas is demolition, not retained
  craft, and therefore remains an ordinary strike plus fresh commission.
-->
<KingdomArchitectureTransitions Schema="2">
  <!-- Verdant, fungal and Moon Stair: canvas -> wattle/timber. -->
  <transition Key="tent-to-hut-s" From="tent" To="hut" Type="housing" Size="S" Mode="renovate"
              Water="4" Materials="timber:4,mud:2" Ticks="1350" />
  <transition Key="tent-to-hut-m" From="tent" To="hut" Type="housing" Size="M" Mode="renovate"
              Water="4" Materials="timber:4,mud:2" Ticks="1350" />
  <transition Key="tent-to-hut-l" From="tent" To="hut" Type="housing" Size="L" Mode="renovate"
              Water="4" Materials="timber:4,mud:2" Ticks="1350" />
  <transition Key="tent-to-hut-xl" From="tent" To="hut" Type="housing" Size="XL" Mode="renovate"
              Water="4" Materials="timber:4,mud:2" Ticks="1350" />
  <transition Key="tentrow-to-hutyard-s" From="tentrow" To="hutyard" Type="housing" Size="S" Mode="renovate"
              Water="7" Materials="timber:7,stone:2" Ticks="1800" />
